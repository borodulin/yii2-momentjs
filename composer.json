{
    "name": "conquer/momentjs",
    "description": "Moment.js for Yii2 with the application locale and PHP date format conversion",
    "keywords": [
        "yii2",
        "extension",
        "widget",
        "momentjs",
        "moment"
    ],
    "homepage": "https://github.com/borodulin/yii2-momentjs",
    "type": "yii2-extension",
    "license": "MIT",
    "authors": [
        {
            "name": "Andrey Borodulin",
            "email": "borodulin@gmail.com",
            "homepage": "https://github.com/borodulin/yii2-momentjs"
        }
    ],
    "extra": {
        "branch-alias": {
            "dev-master": "1.2.x-dev"
        }
    },
    "require": {
        "php": "^7.4 || ^8.0",
        "yiisoft/yii2": "^2.0",
        "bower-asset/moment": "^2.9.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6"
    },
    "autoload": {
        "psr-4": {
            "conquer\\momentjs\\": ""
        }
    },
    "autoload-dev": {
        "psr-4": {
            "conquer\\momentjs\\tests\\": "tests/"
        }
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://asset-packagist.org"
        }
    ],
    "config": {
        "allow-plugins": {
            "yiisoft/yii2-composer": true
        }
    }
}
